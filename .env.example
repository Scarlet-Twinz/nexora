# Local development database (docker-compose.dev.yml maps host 5433 -> container 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nexora_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-long-local-secret

# Stripe is only required for billing/webhook flows. Use Stripe test-mode values.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Web application
NEXT_PUBLIC_API_URL=http://localhost:4000

# Worker / invitation email (optional for local development; without SMTP the worker logs invite links)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexora <no-reply@nexora.local>"
